# Copy to .env.local and fill in. Never commit real values.

# Supabase: the KMR platform project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server only, never expose

# Public address of the website (used in emails and links)
NEXT_PUBLIC_SITE_URL=https://www.kmr-groups.com

# Where the KMR software apps run; the website forwards /it/hrm and /it/console to these
HRM_ORIGIN=https://kmr-hrm.vercel.app
CONSOLE_ORIGIN=https://kmr-console.vercel.app

# Email (Resend). ALERT_EMAIL = inbox for new orders, enquiries and applications
RESEND_API_KEY=your-resend-key
EMAIL_FROM=KMR Group <no-reply@example.com>
ALERT_EMAIL=info@example.com
# RESEND_API_URL=https://api.resend.com/emails          # optional override

# Online payments (Razorpay). Use rzp_test_ keys until go-live
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# RAZORPAY_API_BASE=https://api.razorpay.com/v1         # optional override
